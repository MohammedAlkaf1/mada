# Mada: production environment
# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع ملف .env إلى أي مستودع.
#
# الأسطر المعلّمة (مطلوب) يجب ضبطها قبل أول تشغيل.
# لتوليد سر عشوائي: openssl rand -hex 32

# ---------------------------------------------------------------- الأساس
# (مطلوب) كلمة مرور قاعدة البيانات داخل docker compose. يبني منها compose قيمة DATABASE_URL.
POSTGRES_PASSWORD=

# عند التشغيل خارج compose فقط: رابط الاتصال الكامل بقاعدة PostgreSQL 17.
# داخل compose تُضبط تلقائيًا ولا حاجة لكتابتها هنا.
# DATABASE_URL=postgresql://mada:PASSWORD@db:5432/mada

# (مطلوب) سر توقيع الجلسات. 64 خانة ست عشرية على الأقل.
AUTH_SECRET=

# (مطلوب) العنوان العام للمنصة بالنطاق النهائي وبروتوكول https. تُبنى منه روابط البريد
# وملف sitemap وروابط اللغتين. القيمتان يجب أن تتطابقا.
APP_URL=https://app.example.sa
AUTH_URL=https://app.example.sa

# المنفذ الذي يفتحه compose على الخادم (خلف Nginx أو Caddy عادة).
APP_PORT=3000

# (مطلوب) البريد الذي تصل إليه رسائل نموذج التواصل من الموقع العام.
CONTACT_EMAIL=

# ---------------------------------------------------------------- البريد
# (مطلوب) بدون SMTP_HOST تُكتب الرسائل إلى data/mail ولا تصل لأحد.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Mada <no-reply@example.sa>"

# ---------------------------------------------------------------- الفواتير والضريبة
# نسبة ضريبة القيمة المضافة كنسبة عشرية. أسعار الباقات قبل الضريبة، وتُضاف عند إصدار كل فاتورة.
VAT_RATE=0.15
# بيانات المورد التي تظهر على الفاتورة الضريبية. مع الرقم الضريبي يُطبع رمز QR بصيغة هيئة الزكاة والضريبة والجمارك.
SELLER_NAME=
SELLER_NAME_EN=
SELLER_VAT_NUMBER=
SELLER_CR_NUMBER=
SELLER_ADDRESS=
# متصفح يولّد ملفات PDF. داخل الحاوية مضبوط مسبقًا على chromium؛ على جهاز تطوير يُستخدم Edge أو Chrome المثبت.
# CHROMIUM_PATH=/usr/bin/chromium-browser
# CHROMIUM_CHANNEL=msedge

# ---------------------------------------------------------------- الدفع
# التحويل البنكي يعمل دائمًا. للدفع الإلكتروني عبر Moyasar غيّر القيمة إلى moyasar وأضف المفتاحين.
BILLING_PROVIDER=bank
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
# سر الإشعارات الواردة للمزودين الآخرين على /api/hooks/billing
BILLING_WEBHOOK_SECRET=

# ---------------------------------------------------------------- الملفات
# خادم ClamAV. بدونه تبقى الملفات معلقة (Pending) في الإنتاج بحكم التصميم.
# مع docker compose --profile scan استخدم القيمة clamav.
CLAMAV_HOST=
CLAMAV_PORT=3310
# FILE_SCAN_BYPASS=1 يقبل الملفات بلا فحص. لا تستخدمه إلا في بيئة تجريبية.
# FILE_SCAN_BYPASS=

# ---------------------------------------------------------------- الملفات
# ملفات الدروس (PDF وفيديو MP4 حتى 1 جيجابايت) تُحفظ في هذا المجلد، وهو داخل وحدة التخزين app-data
# المشتركة بين التطبيق والمجدول. انسخه احتياطيًا مع قاعدة البيانات.
FILES_DIR=/app/data/files
# إن كان أمام التطبيق خادم وسيط (Nginx) فاضبط client_max_body_size على 1100m على الأقل لرفع الفيديو.

# ---------------------------------------------------------------- اسم المنتج
# الاسم التجاري الظاهر في رسائل البريد والشهادات والفواتير. غيّره هنا دون تعديل الكود.
PRODUCT_NAME_AR=مدى
PRODUCT_NAME_EN=Mada

# ---------------------------------------------------------------- النسخ الاحتياطية
# تُؤخذ نسخة يومية آليًا من المجدول وتُحفظ في BACKUP_DIR، ويُحتفظ بآخر BACKUP_KEEP نسخة.
# BACKUP_DIR=/app/data/backups
BACKUP_KEEP=14
# (مطلوب للإنتاج) تخزين خارجي متوافق مع S3 حتى لا تبقى النسخ على الخادم نفسه. بدون هذه القيم لا تُرسل نسخة خارجية.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=me-south-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=mada/

# ---------------------------------------------------------------- تتبع الأخطاء
# الأخطاء تُحفظ في قاعدة البيانات وتظهر في لوحة المشغّل دائمًا. هذا الرابط اختياري لإرسال تنبيه
# (Slack أو Teams أو أي مستقبِل JSON) عند أول ظهور لخطأ جديد.
ERROR_WEBHOOK_URL=

# ---------------------------------------------------------------- ممنوع في الإنتاج
# لا تضع DEMO_LOGIN ولا LOCAL_DATABASE_PASSWORD في بيئة الإنتاج.
